buffers: {
  size_kb: 10240
  fill_policy: RING_BUFFER
}
duration_ms: 10000

data_sources: {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "gfx/frame_rendered"
      atrace_categories: "view,wm,am,input,webview,gfx,res,dalvik,sched,graphics"
    }
  }
}
